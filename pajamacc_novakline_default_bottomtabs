        local function Base64Decode(Data)
            local Alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
            local Map = {}
            for Index = 1, 64 do
                Map[Alphabet:sub(Index, Index)] = Index - 1
            end

            Data = Data:gsub("[^%w%+/=]", "")
            local Out = {}
            for Index = 1, #Data, 4 do
                local A = Map[Data:sub(Index, Index)]
                local B = Map[Data:sub(Index + 1, Index + 1)]
                local C = Map[Data:sub(Index + 2, Index + 2)]
                local D = Map[Data:sub(Index + 3, Index + 3)]
                local Number = A * 262144 + B * 4096 + (C or 0) * 64 + (D or 0)
                Out[#Out + 1] = string.char(math.floor(Number / 65536) % 256)
                if C then Out[#Out + 1] = string.char(math.floor(Number / 256) % 256) end
                if D then Out[#Out + 1] = string.char(Number % 256) end
            end
            return table.concat(Out)
        end

