            end)

            if wasEnabled then
                toggleHiddenInterface(selectedUIName, true)
                activeUIName = selectedUIName
            end
            sendNotification("Interface", "Interface list refreshed.")
        end)

        UIUtilitiesGroup:AddLabel("Select an interface, then use Toggle Interface.")
    end
