            if ok then fired = fired + 1 end
        end
    end

    
    if fired == 0 then
        fired = FirePromptsInArea(18, "safe")
    end
    if fired == 0 then
        
        fired = FirePromptsInArea(7)
    end
    return fired > 0, fired > 0 and nil or "No enabled safe prompt was found"
end

