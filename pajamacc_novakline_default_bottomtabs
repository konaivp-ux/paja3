    function Library:PlayUISound(soundName)
        local sound = UISounds[tostring(soundName)]
        if not sound or not sound.Parent then return end
        local now = os.clock()
        if now - LastUISound < 0.045 then return end
        LastUISound = now
        sound:Stop()
        sound.TimePosition = 0
        sound:Play()
    end

