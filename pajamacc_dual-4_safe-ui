function D.mobileFit()
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(844, 390)
	local sc = math.min(1, vp.X * 0.96 / 720)
	local h = math.clamp(math.floor(vp.Y * 0.94 / sc), 300, 640)
	return sc, h
end

