	local SubIndex = math.random(40,100);
	local KeybindInd = Compkiller:_DrawKeybinds(Window);
	local KeybindFrame = KeybindInd:AddFrame();

	local KeybindHandler = Instance.new("Frame")
	local UIStroke = Instance.new("UIStroke")
