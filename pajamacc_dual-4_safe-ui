            local FontPath = `{Library.Folders.Assets}/Starborn.font`
            writefile(TtfPath, Base64Decode(STARBORN_B64))
            writefile(FontPath, HttpService:JSONEncode({
                name = "Starborn",
                faces = {
                    {
                        name = "Regular",
                        weight = 400,
                        style = "normal",
                        assetId = getcustomasset(TtfPath)
                    }
                }
            }))
            return Font.new(getcustomasset(FontPath))
        end)

