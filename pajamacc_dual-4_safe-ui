	self.Row.colorId = cid
	D.registerFlag(cid, self.Row.color)
	watchCallback(cid, o.Callback, "color")
	self.Color = setmetatable({Flag = cid, Row = self.Row, Kind = "color", Page = self.Page}, Element)
	API.Elements[cid] = self.Color
	rebuild()
