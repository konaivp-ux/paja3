-- make text fit: long names get cut with "..." instead of spilling out of their boxes
local function fitText(root)
    if not root then return end
    for _, inst in ipairs(root:GetDescendants()) do
        if inst:IsA("TextLabel") or inst:IsA("TextButton") then
            local okAuto, auto = pcall(function() return inst.AutomaticSize end)
            if okAuto and auto == Enum.AutomaticSize.None then
                pcall(function() inst.TextTruncate = Enum.TextTruncate.AtEnd end)
            end
        end
    end
end
