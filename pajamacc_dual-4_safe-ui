end

-- ---------- notifications ----------
function Library:Notify(first, second, third)
    if getgenv().MiamiSuppressNotifications or Library._unloaded then return end
    local title, text, duration
    if type(first) == "table" then
        title = tostring(first.Title or first.title or "Pajama.cc")
        text = tostring(first.Content or first.content or first.Description or first.description or "")
        duration = first.Duration or first.duration or second or 4
    elseif type(second) == "string" then
        title, text, duration = tostring(first or "Pajama.cc"), second, third or 4
    else
        local raw = tostring(first or "Notification")
        local head, rest = string.match(raw, "^([^\n]*)\n(.*)$")
        if head then
            title, text = head, rest
        else
            title, text = "Pajama.cc", raw
        end
        duration = second or 4
    end
    pcall(function()
        Arvn:Notify({ Title = title, Content = text, Duration = tonumber(duration) or 4 })
    end)
end

function Library:ChangeTheme(name, color)
