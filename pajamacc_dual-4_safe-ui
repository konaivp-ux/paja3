	local row = common({t = "slider", label = name, min = o.Min or 0, max = o.Max or 100, step = step, suf = o.Suffix, maxLabel = o.MaxLabel, commit = o.CommitOnRelease or o.Live == false}, o)
	row.id = autoId(self, "slider", name, o.Flag)
