	if mode == "Keybinds Only" and source ~= "bind" then return end
	D.notify(D.LABELS[spec.id] or spec.label, v and "Enabled" or "Disabled", {icon = v and "circle-check" or "power", dur = 1.8, compact = true, sound = "none"})
