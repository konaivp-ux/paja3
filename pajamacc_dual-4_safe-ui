	D.ensureDir(DIR)
	D.ensureDir(DIR .. "/configs")
	D.ensureDir(cfgDir())
	local snap = D.snapshot(true)
	snap.__saved = os.time()
	return pcall(writefile, cfgDir() .. "/" .. name .. ".json", HttpService:JSONEncode(snap))
end

function D.readConfig(name)
	if not fsOk() then return nil end
