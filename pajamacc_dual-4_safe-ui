            sendNotification("Dupe","Returning..."); SilentBypassTeleport(origLoc); task.wait(0.5)
            
            local i = 1
            while autoDupeActive and (targetSpeed == math.huge or i <= targetSpeed) do
                SafeDupeOnce(selectedDupeItem, origLoc)
