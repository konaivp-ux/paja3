	self.Row.nobind = nil
	if D.DEF_BIND[self.Flag] == nil then D.DEF_BIND[self.Flag] = {key = key, mode = mode, list = true} end
	if D.BIND[self.Flag] == nil then
		D.BIND[self.Flag] = {key = key, mode = mode, list = true}
