	UIStroke.Parent = KeybindHandler

	table.insert(Compkiller.Elements.HighStrokeColor,{
		Element = UIStroke,
		Property = 'Color'
	});

	UICorner.CornerRadius = UDim.new(0, 6)
	UICorner.Parent = KeybindHandler

