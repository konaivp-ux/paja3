        local function setSelectedInterfaceEnabled(state)
            if state then
                if not selectedUIName or selectedUIName == "" then
                    sendNotification("Interface", "Select an interface first.")
                    return false
                end

                if activeUIName and activeUIName ~= selectedUIName then
