	Chime = {0.75, function(t)
		local a = (sine(988, t) + sine(1976, t) * 0.25) * math.exp(-t * 8)
		local t2 = t - 0.09
		local b = t2 > 0 and (sine(1319, t2) + sine(2638, t2) * 0.25) * math.exp(-t2 * 8) or 0
