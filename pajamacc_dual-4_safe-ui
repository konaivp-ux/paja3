local function pushRecent(hex)
	local r = D.META.recent
	if type(r) ~= "table" then r = {} end
	local idx = table.find(r, hex)
	if idx then table.remove(r, idx) end
	table.insert(r, 1, hex)
	while #r > 9 do table.remove(r) end
	D.META.recent = r
end

