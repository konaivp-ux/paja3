            if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
                pcall(function() inst.FontFace = face end)
            end
        end
    end
    pcall(function() restyle(Lds.Holder.Instance) end)
    pcall(function() restyle(Lds.UnusedHolder.Instance) end)
    Library.FitText()
end

