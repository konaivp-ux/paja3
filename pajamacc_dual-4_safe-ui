-- ---------- controls (Options / Toggles) ----------
local function toMap(list)
    local m = {}
    if type(list) == "table" then
        for k, v in pairs(list) do
            if type(k) == "number" then m[v] = true elseif v then m[k] = true end
        end
    end
    return m
end

local function toList(map)
    local l = {}
    if type(map) == "table" then
        for k, v in pairs(map) do
            if type(k) == "number" then l[#l + 1] = v elseif v then l[#l + 1] = k end
        end
        table.sort(l, function(a, b) return tostring(a) < tostring(b) end)
    end
    return l
end

local function makeControl(flag, el, kind, multi)
    local control = { Flag = flag, Type = kind, Element = el, Values = {} }
    local function read()
        if kind == "Color" then
            local ok, c = pcall(function() return el:GetColor() end)
            return ok and c or Color3.new(1, 1, 1)
        end
        local v = el:Get()
        if multi then return toMap(v) end
        return v
    end
    setmetatable(control, {
        __index = function(_, k)
            if k == "Value" then return read() end
        end,
        __newindex = function(t, k, v)
            if k == "Value" then
                control:SetValue(v)
            else
                rawset(t, k, v)
            end
        end,
    })
    function control:SetValue(v)
        if multi then v = toList(v) end
        el:Set(v)
        return self
    end
    control.Set = control.SetValue
    control.SetValueRGB = control.SetValue
    function control:GetState() return read() end
    function control:OnChanged(fn)
        if type(fn) == "function" then
            el:OnChanged(function(...)
                if multi then safe(fn, read()) else safe(fn, ...) end
            end)
        end
        return self
    end
    function control:SetValues(values)
        self.Values = values or {}
        pcall(function() el:SetValues(self.Values, false) end)
        return self
    end
    control.Refresh = control.SetValues
    function control:Lock() pcall(function() el:Lock() end) return self end
    function control:Unlock() pcall(function() el:Unlock() end) return self end
    function control:SetVisible(v) pcall(function() el:SetVisible(v ~= false) end) return self end
    function control:SetDisabled(v) pcall(function() el:SetDisabled(v == true) end) return self end
    function control:SetText(t) pcall(function() el:SetName(tostring(t)) end) return self end
    return control
end

local function newFlag(flag, data)
    if flag == nil or flag == "" then
        flag = "Taco_" .. tostring(math.random(100000, 999999))
    end
    return tostring(flag)
end

-- ---------- groupbox ----------
local Group = {}
Group.__index = Group

function Group:AddLabel(text, wrap)
    local c = self.Raw
    local el = c:Label({ Text = tostring(text or ""), Wrap = (wrap == true) or nil })
    local label = { _el = el, _group = self }
    function label:SetText(value)
        pcall(function() el:SetText(tostring(value or "")) end)
        return self
    end
    function label:SetVisible(v) pcall(function() el:SetVisible(v ~= false) end) return self end
    function label:AddColorPicker(flag, data)
        return self._group:_color(flag, data)
    end
    function label:AddKeyPicker(flag, data)
        data = data or {}
        flag = newFlag(flag)
        -- the menu key is owned by arvn (Settings > Interface), so just mirror it
        if flag == "MenuKeybind" then
            local control = { Flag = flag, Type = "KeyPicker", Values = {} }
            setmetatable(control, {
                __index = function(_, k)
                    if k == "Value" then return Arvn.Flags.ui_menukey or "RightShift" end
                end,
            })
            function control:SetValue(v) Arvn.Flags.ui_menukey = tostring(v) return self end
            control.Set = control.SetValue
            function control:OnChanged() return self end
            function control:GetState() return Arvn.Flags.ui_menukey end
            Options[flag] = control
            return control
        end
        local key = tostring(data.Default or "None"):gsub("Enum%.KeyCode%.", "")
        local el = self._group.Raw:Keybind({
            Name = data.Text or flag,
            Flag = flag,
            Default = key,
            Mode = data.Mode,
            Callback = data.Callback or data.callback,
