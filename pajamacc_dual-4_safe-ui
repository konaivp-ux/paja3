-- Pajama.cc (dual UI)
-- On first run you get a small picker to choose the interface:
--   arvn     : named tabs, themes and saved configs
--   Original : the small, draggable lds13 window with icon tabs and a UI Scale slider
--   Novoline : the Original window in the Novoline client's dark gray palette
--   CompKiller x Novoline : CompKiller's sidebar UI in Novoline's palette, with the Pajama outline
-- "Remember my choice" saves it to bread_cc_ui.txt so you are only asked once
-- (delete that file to be asked again). To skip the picker, run
--   getgenv().BreadccUI = "arvn"   -- or "lds13" / "novoline" / "compkiller"
-- before this script. Both UI libraries are embedded; only the chosen one is run.
-- The script logic below is identical for both.

local UI_CHOICE
do
    local SAVE_FILE = "bread_cc_ui.txt"
    local function normalize(v)
        v = string.lower(tostring(v or ""))
        v = v:gsub("%s+", "")
        if v == "arvn" then return "arvn" end
        if v == "lds13" or v == "original" then return "lds13" end
        if v == "novoline" then return "novoline" end
        if v == "compkiller" or v == "mix" then return "compkiller" end
        return nil
    end

    UI_CHOICE = normalize(getgenv().BreadccUI)

    if not UI_CHOICE and readfile and isfile then
        local ok, saved = pcall(function()
            if isfile(SAVE_FILE) then return readfile(SAVE_FILE) end
        end)
        if ok then UI_CHOICE = normalize(saved) end
    end

    if not UI_CHOICE then
        local Players = game:GetService("Players")
        local gui = Instance.new("ScreenGui")
        gui.Name = "BreadccUIPicker"
        gui.ResetOnSpawn = false
        gui.IgnoreGuiInset = true
        gui.DisplayOrder = 100000
        pcall(function() gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling end)
        pcall(function() if syn and syn.protect_gui then syn.protect_gui(gui) end end)

        local parented = pcall(function()
            gui.Parent = (gethui and gethui()) or game:GetService("CoreGui")
        end)
        if not parented or not gui.Parent then
            gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
        end

        local function round(inst, r)
            local c = Instance.new("UICorner")
            c.CornerRadius = UDim.new(0, r)
            c.Parent = inst
        end

        local card = Instance.new("Frame")
        card.AnchorPoint = Vector2.new(0.5, 0.5)
        card.Position = UDim2.new(0.5, 0, 0.5, 0)
        card.Size = UDim2.new(0, 320, 0, 380)
        card.BackgroundColor3 = Color3.fromRGB(17, 17, 19)
        card.BorderSizePixel = 0
        card.Parent = gui
        round(card, 12)
        local stroke = Instance.new("UIStroke")
        stroke.Color = Color3.fromRGB(255, 255, 255)
        stroke.Transparency = 0.9
        stroke.Parent = card

        local function label(text, size, y, h, color)
            local l = Instance.new("TextLabel")
            l.BackgroundTransparency = 1
            l.Position = UDim2.new(0, 16, 0, y)
            l.Size = UDim2.new(1, -32, 0, h)
            l.Font = Enum.Font.GothamMedium
            l.TextSize = size
            l.TextColor3 = color
            l.Text = text
            l.TextXAlignment = Enum.TextXAlignment.Left
            l.Parent = card
            return l
        end
        label("Pajama.cc", 20, 12, 26, Color3.fromRGB(238, 238, 240))
        label("Choose your interface", 13, 38, 18, Color3.fromRGB(143, 143, 151))

        local chosen
        local function option(title, desc, y, key)
            local b = Instance.new("TextButton")
            b.AutoButtonColor = true
            b.Position = UDim2.new(0, 16, 0, y)
            b.Size = UDim2.new(1, -32, 0, 56)
            b.BackgroundColor3 = Color3.fromRGB(33, 33, 37)
            b.BorderSizePixel = 0
            b.Text = ""
            b.Parent = card
            round(b, 8)
            local t = Instance.new("TextLabel")
            t.BackgroundTransparency = 1
            t.Position = UDim2.new(0, 12, 0, 8)
            t.Size = UDim2.new(1, -24, 0, 20)
            t.Font = Enum.Font.GothamBold
            t.TextSize = 15
            t.TextColor3 = Color3.fromRGB(238, 238, 240)
            t.TextXAlignment = Enum.TextXAlignment.Left
            t.Text = title
            t.Parent = b
            local d = Instance.new("TextLabel")
            d.BackgroundTransparency = 1
            d.Position = UDim2.new(0, 12, 0, 29)
            d.Size = UDim2.new(1, -24, 0, 18)
            d.Font = Enum.Font.Gotham
            d.TextSize = 12
            d.TextColor3 = Color3.fromRGB(143, 143, 151)
            d.TextXAlignment = Enum.TextXAlignment.Left
            d.Text = desc
            d.Parent = b
            b.Activated:Connect(function() chosen = key end)
        end
        option("CompKiller x Novoline", "Sidebar UI in Novoline's dark grays", 68, "compkiller")
        option("arvn UI", "Named tabs, themes, saved configs", 132, "arvn")
        option("Original UI", "Small, draggable window with icon tabs", 196, "lds13")
        option("Novoline UI", "Original window in Novoline's dark grays", 260, "novoline")

        local remember = true
        local rb = Instance.new("TextButton")
        rb.BackgroundTransparency = 1
        rb.Position = UDim2.new(0, 16, 0, 334)
        rb.Size = UDim2.new(1, -32, 0, 28)
        rb.Font = Enum.Font.Gotham
        rb.TextSize = 13
        rb.TextColor3 = Color3.fromRGB(190, 190, 196)
        rb.TextXAlignment = Enum.TextXAlignment.Left
        rb.Parent = card
        local function paint()
            rb.Text = (remember and "[x] " or "[  ] ") .. "Remember my choice"
        end
        paint()
        rb.Activated:Connect(function() remember = not remember paint() end)

        repeat task.wait() until chosen
        pcall(function() gui:Destroy() end)
        UI_CHOICE = chosen

        if remember and writefile then
            pcall(writefile, SAVE_FILE, chosen)
        end
    end
end

