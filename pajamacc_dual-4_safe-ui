		end
	end)
	table.sort(out, function(a, b) return string.lower(a) < string.lower(b) end)
	return out
end

function D.cleanName(n)
	n = string.gsub(tostring(n or ""), "[^%w%-_ ]", "")
	n = string.gsub(n, "^%s+", "")
	n = string.gsub(n, "%s+$", "")
	return string.sub(n, 1, 32)
end

function D.saveConfig(name)
	name = D.cleanName(name)
