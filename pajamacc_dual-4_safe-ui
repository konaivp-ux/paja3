function D.logError(err)
	local e = API.Errors
	e[#e + 1] = {t = os.time(), msg = tostring(err)}
	while #e > 60 do table.remove(e, 1) end
	if API.ShowErrors then D.notify("Script error", tostring(err), {kind = "Error", dur = 6}) end
