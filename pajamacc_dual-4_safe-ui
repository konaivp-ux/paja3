			local raw
			if getclipboard then
				local ok, r = pcall(getclipboard)
				if ok then raw = r end
			end
			local hx = raw and string.match(raw, "#?(%x%x%x%x%x%x%x?%x?)")
			if hx then
				local cc
				cc, a = D.parseColor(hx)
				h, s, v = cc:ToHSV()
