-- ---------- tabs ----------
local function newTab(rawTab)
    local tab = { Raw = rawTab }
    local function section(name, side)
        return newGroup(rawTab:Section({ Name = tostring(name or "Group"), Side = side }))
    end
    function tab:AddLeftGroupbox(name) return section(name, "Left") end
    function tab:AddRightGroupbox(name) return section(name, "Right") end
    local function tabbox(name, side)
        local sec = rawTab:Section({ Name = tostring(name or "Extra"), Side = side })
        local box = { _sec = sec, _n = 0 }
        function box:AddTab(tabName)
            self._n = self._n + 1
            return newGroup(self._sec:Page(tostring(tabName or ("Page " .. self._n))))
        end
        return box
    end
    function tab:AddLeftTabbox(name) return tabbox(name, "Left") end
    function tab:AddRightTabbox(name) return tabbox(name, "Right") end
    return tab
end

